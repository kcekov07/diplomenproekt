@model EcoLoop.Models.Profile.ProfileIndexViewModel
@{
    ViewData["Title"] = "Моят профил";
}

<section class="profile-shell">
    <article class="profile-hero-card">
        <div class="profile-avatar-wrap">
            @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
            {
                <img src="@Model.ProfileImageUrl" alt="@Model.Username" class="profile-avatar" />
            }
            else
            {
                <div class="profile-avatar profile-avatar-placeholder">@Model.Username[..1]</div>
            }
        </div>

        <div class="profile-content">
            <p class="profile-label">Профил</p>
            <h1>@Model.Username</h1>
            <p class="profile-meta">@Model.Email</p>

            <div class="profile-pill-list">
                <span class="profile-pill">Роля: @Model.Role</span>
                <span class="profile-pill">Ниво: @Model.Level</span>
            </div>

            <div class="profile-actions">
                <a class="btn btn-primary" asp-controller="Profile" asp-action="Edit">Редактирай профила</a>
                @if (User.IsInRole("User") || User.IsInRole("Moderator") || User.IsInRole("Producer"))
                {
                    <a class="btn btn-outline-primary" asp-controller="Profile" asp-action="Statistics">Виж статистики</a>
                }
              
                @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                {
                    <a class="btn btn-dark" asp-controller="Admin" asp-action="Index">Отвори админ панел</a>
                }

            @if (TempData["ProfileSuccess"] is string successMessage)
            {
                <p class="profile-success">✅ @successMessage</p>
            }
        </div>
    </article>
</section>