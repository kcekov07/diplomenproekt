@model EcoLoop.Models.NewsFormViewModel
@{
    ViewData["Title"] = "Редактирай новина";
}

@section Styles {
    <link rel="stylesheet" href="~/css/news.css" asp-append-version="true" />
}

<section class="news-form-wrap">
    <header class="news-form-intro">
        <span class="news-kicker">Редактор</span>
        <h1>Редактирай новина</h1>
        <p>Обнови текста, категорията и визията, за да остане публикацията актуална и четима.</p>
    </header>
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="news-form-card">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <partial name="_NewsForm" model="Model" />

        <div class="news-form-actions">
            <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Отказ</a>
            <button class="btn btn-primary" type="submit">Запази</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}