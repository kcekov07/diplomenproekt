@model EventFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="events-form-grid">
    <label class="events-filter-field events-filter-card">
        <span>Заглавие</span>
        <input asp-for="Title" class="form-control events-input" placeholder="Напр. Градско почистване" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </label>

    <div class="events-filter-field events-filter-card">
        <span>Снимка</span>
        <input asp-for="ImageFile" type="file" class="form-control events-input" accept="image/png,image/jpeg,image/gif,image/webp" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
        <input asp-for="RemoveImage" type="hidden" />
        <input asp-for="ExistingImageUrl" type="hidden" />

        <div id="event-image-preview" class="mt-2 @(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "d-none" : string.Empty)">
            <img id="event-image-preview-img" src="@(Model.ExistingImageUrl ?? "")" alt="Преглед на снимката" />   
            <button id="event-image-remove-btn" type="button" class="btn btn-sm btn-outline-danger mt-2">Премахни снимката</button>
        </div>
        <small class="small-muted">Качи снимка от устройството. Можеш да смениш или премахнеш преди запис.</small>
    </div>

    <label class="events-filter-field events-filter-card">
        <span>Дата</span>
        <input asp-for="Date" class="form-control events-input" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </label>
    <label class="events-filter-field events-filter-card">
        <span>Град</span>
        <input asp-for="City" class="form-control events-input" placeholder="София" />
        <span asp-validation-for="City" class="text-danger"></span>
    </label>

    <label class="events-filter-field events-filter-card events-filter-field--full">
        <span>Адрес</span>
        <input asp-for="Address" class="form-control events-input" placeholder="ул. Пример 10, София" />
        <small class="small-muted">Добави пълен адрес, за да могат участниците лесно да намерят събитието.</small>
        <span asp-validation-for="Address" class="text-danger"></span>
    </label>

    <label class="events-filter-field events-filter-card">
        <span>Тип</span>
        <div class="event-type-row">
            <select asp-for="Type" class="form-select events-input">
                <option value="">Избери тип</option>
                @foreach (var eventType in Model.AvailableTypes)
                {
                    <option value="@eventType">@eventType</option>
                }
            </select>
            <input asp-for="CustomType" class="form-control events-input" placeholder="Или нов тип" />
        </div>
        <small class="small-muted">Можеш да избереш готов тип или да въведеш нов.</small>
        <span asp-validation-for="Type" class="text-danger"></span>
        <span asp-validation-for="CustomType" class="text-danger"></span>
    </label>


    <label class="events-filter-field events-filter-field--full events-filter-card">
        <span>Кратко описание</span>
        <textarea asp-for="ShortDescription" class="form-control events-input" rows="4" placeholder="Добави важни детайли за събитието..."></textarea>
        <span asp-validation-for="ShortDescription" class="text-danger"></span>
    </label>
</div>

<script>
    (() => {
        const imageInput = document.getElementById('ImageFile');
        const previewWrap = document.getElementById('event-image-preview');
        const previewImg = document.getElementById('event-image-preview-img');
        const removeBtn = document.getElementById('event-image-remove-btn');
        const removeFlag = document.getElementById('RemoveImage');

        if (!imageInput || !previewWrap || !previewImg || !removeBtn || !removeFlag) return;

        imageInput.addEventListener('change', () => {
            const file = imageInput.files && imageInput.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                previewImg.src = e.target?.result;
                previewWrap.classList.remove('d-none');
                removeFlag.value = 'false';
            };
            reader.readAsDataURL(file);
        });

        removeBtn.addEventListener('click', () => {
            imageInput.value = '';
            previewImg.src = '';
            previewWrap.classList.add('d-none');
            removeFlag.value = 'true';
        });
    })();
</script>