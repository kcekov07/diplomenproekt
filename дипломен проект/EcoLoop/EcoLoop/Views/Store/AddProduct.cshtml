@model EcoLoop.Models.StoreProductInputModel

@{
    ViewData["Title"] = "Добавяне на продукт";
}

@section Styles {
    <link rel="stylesheet" href="~/css/store-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/store-catalog.css" asp-append-version="true" />
}

<section class="product-form-page">
    <div class="catalog-page__head">
        <div>
            <h1>Добави продукт</h1>
            <p class="sd-muted">Магазин: <strong>@ViewBag.StoreName</strong></p>
        </div>
        <a class="sd-btn" asp-controller="Store" asp-action="Catalog" asp-route-id="@Model.StoreId">Към каталога</a>
    </div>

    @if (TempData["CatalogError"] != null)
    {
        <div class="catalog-alert">@TempData["CatalogError"]</div>
    }

    <div class="catalog-form-card">
        <p class="catalog-form-card__helper">
            Добави продукт с ясно описание, независимо дали е храна, напитка, козметика, грижа за дома,
            дрехи или друг еко артикул.
        </p>
        <div class="catalog-chip-list">
            <span class="catalog-chip">🥗 Храни и напитки</span>
            <span class="catalog-chip">🧴 Козметика и грижа</span>
            <span class="catalog-chip">🧺 Дом и ежедневие</span>
            <span class="catalog-chip">👕 Мода и аксесоари</span>
        </div>

        <form asp-controller="Store" asp-action="AddProduct" method="post" enctype="multipart/form-data" class="catalog-manage catalog-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StoreId" />

            <label>
                Име на продукта
                <input asp-for="Name" maxlength="160" required placeholder="Напр. Био овесени ядки / Еко препарат" />
            </label>

            <label>
                Описание
                <textarea asp-for="Description" maxlength="600" placeholder="Състав, произход, предназначение, устойчиви предимства..."></textarea>
            </label>

            <div class="catalog-form__row">
                <label>
                    Цена
                    <input asp-for="Price" type="number" step="0.01" min="0.01" required />
                </label>
                <label>
                    Единица
                    <input asp-for="Unit" maxlength="100" placeholder="бр., кг, мл, комплект" />
                </label>
            </div>

            <label>
                Изображение на продукта
                <input id="productImageInput" asp-for="ProductImage" type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
                <div id="productImagePreview" class="catalog-image-preview">
                    <img id="productImagePreviewImg" src="" alt="Преглед на снимката" />
                    <div id="productImagePreviewMeta" class="catalog-image-preview__meta"></div>
                </div>
            </label>

            <label>
                Етикети
                <input asp-for="Labels" maxlength="200" placeholder="био, локално, refill, zero waste" />
            </label>

            <label class="catalog-form__switch">
                <input asp-for="IsAvailable" /> Налично в момента
            </label>

            <button type="submit" class="sd-btn sd-btn--primary">Публикувай продукт</button>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('productImageInput');
            const preview = document.getElementById('productImagePreview');
            const previewImg = document.getElementById('productImagePreviewImg');
            const previewMeta = document.getElementById('productImagePreviewMeta');

            if (!input || !preview || !previewImg || !previewMeta) {
                return;
            }

            input.addEventListener('change', () => {
                const file = input.files && input.files[0];
                if (!file) {
                    preview.classList.remove('is-visible');
                    previewImg.src = '';
                    previewMeta.textContent = '';
                    return;
                }

                const objectUrl = URL.createObjectURL(file);
                previewImg.src = objectUrl;
                previewMeta.textContent = `${file.name} • ${Math.max(1, Math.round(file.size / 1024))} KB`;
                preview.classList.add('is-visible');

                previewImg.onload = () => URL.revokeObjectURL(objectUrl);
            });
        })();
    </script>
}
