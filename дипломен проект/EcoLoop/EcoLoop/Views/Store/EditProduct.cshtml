@model EcoLoop.Models.StoreProductInputModel


@{
    ViewData["Title"] = "Редакция на продукт";
    var currentImageUrl = ViewBag.CurrentImageUrl as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/store-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/store-catalog.css" asp-append-version="true" />
}

<section class="product-form-page">
    <div class="catalog-page__head">
        <div>
            <h1>Редактирай продукт</h1>
            <p class="sd-muted">Магазин: <strong>@ViewBag.StoreName</strong></p>
        </div>
        <a class="sd-btn" asp-controller="Store" asp-action="Catalog" asp-route-id="@Model.StoreId">Към каталога</a>
    </div>

    @if (TempData["CatalogError"] != null)
    {
        <div class="catalog-alert">@TempData["CatalogError"]</div>
    }

    <div class="catalog-form-card">
        <p class="catalog-form-card__helper">Обнови информацията, за да е ясна за всички типове продукти — хранителни и нехранителни.</p>

        <form asp-controller="Store" asp-action="EditProduct" method="post" enctype="multipart/form-data" class="catalog-manage catalog-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StoreId" />
            <input type="hidden" name="id" value="@ViewBag.ProductId" />

            <label>
                Име на продукта
                <input asp-for="Name" maxlength="160" required />
            </label>

            <label>
                Описание
                <textarea asp-for="Description" maxlength="600"></textarea>
            </label>

            <div class="catalog-form__row">
                <label>
                    Цена
                    <input asp-for="Price" type="number" step="0.01" min="0.01" required />
                </label>
                <label>
                    Единица
                    <input asp-for="Unit" maxlength="100" placeholder="бр., кг, мл, комплект" />
                </label>
            </div>

            <label>
                Нова снимка (по желание)
                <input id="productImageInput" asp-for="ProductImage" type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
                <div id="productImagePreview" class="catalog-image-preview @(string.IsNullOrWhiteSpace(currentImageUrl) ? "" : "is-visible")">
                    <img id="productImagePreviewImg"
                         src="@(string.IsNullOrWhiteSpace(currentImageUrl) ? "" : currentImageUrl)"
                         alt="Преглед на снимката" />
                    <div id="productImagePreviewMeta" class="catalog-image-preview__meta">
                        @(string.IsNullOrWhiteSpace(currentImageUrl) ? "" : "Текуща снимка на продукта")
                    </div>
                </div>
            </label>

            <label>
                Етикети
                <input asp-for="Labels" maxlength="200" />
            </label>

            <label class="catalog-form__switch">
                <input asp-for="IsAvailable" /> Налично в момента
            </label>

            <button type="submit" class="sd-btn sd-btn--primary">Запази промените</button>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('productImageInput');
            const preview = document.getElementById('productImagePreview');
            const previewImg = document.getElementById('productImagePreviewImg');
            const previewMeta = document.getElementById('productImagePreviewMeta');
            const defaultImage = '@(string.IsNullOrWhiteSpace(currentImageUrl) ? "" : currentImageUrl)';

            if (!input || !preview || !previewImg || !previewMeta) {
                return;
            }

            input.addEventListener('change', () => {
                const file = input.files && input.files[0];
                if (!file) {
                    if (defaultImage) {
                        previewImg.src = defaultImage;
                        previewMeta.textContent = 'Текуща снимка на продукта';
                        preview.classList.add('is-visible');
                    } else {
                        preview.classList.remove('is-visible');
                        previewImg.src = '';
                        previewMeta.textContent = '';
                    }
                    return;
                }

                const objectUrl = URL.createObjectURL(file);
                previewImg.src = objectUrl;
                previewMeta.textContent = `${file.name} • ${Math.max(1, Math.round(file.size / 1024))} KB`;
                preview.classList.add('is-visible');

                previewImg.onload = () => URL.revokeObjectURL(objectUrl);
            });
        })();
    </script>
}
