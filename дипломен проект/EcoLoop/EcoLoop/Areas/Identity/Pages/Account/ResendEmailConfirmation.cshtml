@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Повторно изпращане на потвърждение";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-pages.css" />
}

<div class="auth-shell">
    <div class="auth-card auth-compact">
        <div class="auth-grid">
            <aside class="auth-hero">
                <div>
                    <span class="auth-kicker">Email Verification</span>
                    <h1>Потвърди имейла си и отключи всички функции</h1>
                    <p>Не си получил имейл? Няма проблем — ще изпратим ново потвърждение веднага.</p>
                </div>
                <ul>
                    <li>По-сигурен профил в EcoLoop</li>
                    <li>Пълна функционалност след верификация</li>
                </ul>
            </aside>

            <section class="auth-content">
                <h2>Изпрати потвърждение отново</h2>
                <p class="auth-subtitle">Въведи своя имейл и ще получиш нов линк за потвърждение.</p>

                <form method="post" class="auth-form-surface">
                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary auth-btn">Изпрати отново</button>

                    <p class="mt-3 mb-0 auth-links">Готово? <a asp-page="./Login">Влез в акаунта</a>.</p>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}