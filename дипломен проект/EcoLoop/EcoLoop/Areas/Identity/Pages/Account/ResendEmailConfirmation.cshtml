@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Повторно изпращане на потвърждение";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-pages.css" />
}

<div class="auth-shell">
    <div class="auth-card" style="max-width:680px;">
        <div class="auth-content">
            <h2>Повтори потвърждението</h2>
            <p class="text-muted">Ако не си получил имейл, въведи адреса си и ще изпратим ново потвърждение.</p>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary auth-btn">Изпрати отново</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}