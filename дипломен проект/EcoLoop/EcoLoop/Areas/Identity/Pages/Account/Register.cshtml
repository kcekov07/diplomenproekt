@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-pages.css" />
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-grid">
            <aside class="auth-hero">
                <div>
                    <span class="auth-kicker">Join EcoLoop</span>
                    <h1>Създай профил и стани част от зелената промяна</h1>
                    <p>Превърни ежедневните си избори в реален позитивен ефект за природата и града.</p>
                </div>
                <ul>
                    <li>Откривай устойчиви обекти около теб</li>
                    <li>Участвай в еко събития и инициативи</li>
                    <li>Следи своя прогрес и еко влияние</li>
                </ul>
            </aside>

            <section class="auth-content">
                <h2>Нова регистрация</h2>
                <p class="auth-subtitle">Създай своя модерен EcoLoop профил за по-малко от минута.</p>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data" class="auth-form-surface">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Username" class="form-control" placeholder="Username" />
                        <label asp-for="Input.Username"></label>
                        <span asp-validation-for="Input.Username" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                        <label asp-for="Input.Email"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="password" />
                        <label asp-for="Input.Password"></label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="confirm" />
                        <label asp-for="Input.ConfirmPassword"></label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Role" class="form-label"></label>
                        <select asp-for="Input.Role" class="form-select">
                            <option value="User">User</option>
                            <option value="Producer">Producer</option>
                        </select>
                        <span asp-validation-for="Input.Role" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ProfileImage" class="form-label"></label>
                        <input asp-for="Input.ProfileImage" id="profileImageInput" class="form-control" accept="image/*" />
                        <span asp-validation-for="Input.ProfileImage" class="text-danger"></span>
                        <div class="avatar-preview-wrap">
                            <img id="profilePreview" class="avatar-preview" src="~/images/default-avatar.svg" alt="Преглед на профилна снимка" />
                            <small class="text-muted">Добави личен акцент към профила си или използвай EcoLoop аватара по подразбиране.</small>
                        </div>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary auth-btn">Създай профил</button>

                    <p class="mt-3 mb-0 auth-links">Имаш профил? <a asp-page="./Login">Влез тук</a>.</p>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const profileInput = document.getElementById('profileImageInput');
        const profilePreview = document.getElementById('profilePreview');
        const defaultAvatar = '@Url.Content("~/images/default-avatar.svg")';

        if (profileInput && profilePreview) {
            profileInput.addEventListener('change', () => {
                const file = profileInput.files && profileInput.files[0];
                if (!file) {
                    profilePreview.src = defaultAvatar;
                    return;
                }

                profilePreview.src = URL.createObjectURL(file);
            });
        }
    </script>
}