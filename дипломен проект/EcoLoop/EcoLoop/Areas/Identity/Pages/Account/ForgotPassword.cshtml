@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Забравена парола";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-pages.css" />
}

<div class="auth-shell">
    <div class="auth-card" style="max-width:680px;">
        <div class="auth-content">
            <h2>Възстановяване на достъп</h2>
            <p class="text-muted">Въведи имейла си и ще ти изпратим инструкции за нова парола.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary auth-btn">Изпрати линк за нова парола</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}