@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Забравена парола";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-pages.css" />
}

<div class="auth-shell">
    <div class="auth-card auth-compact">
        <div class="auth-grid">
            <aside class="auth-hero">
                <div>
                    <span class="auth-kicker">Password Recovery</span>
                    <h1>Възстанови достъпа си сигурно и бързо</h1>
                    <p>Ще ти изпратим линк за смяна на парола, за да продължиш без прекъсване.</p>
                </div>
                <ul>
                    <li>Сигурна процедура с имейл потвърждение</li>
                    <li>Няколко бързи стъпки до нова парола</li>
                </ul>
            </aside>

            <section class="auth-content">
                <h2>Забравена парола</h2>
                <p class="auth-subtitle">Въведи имейла от твоя профил и ще изпратим инструкции.</p>

                <form method="post" class="auth-form-surface">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary auth-btn">Изпрати линк за нова парола</button>

                    <p class="mt-3 mb-0 auth-links">Спомни си паролата? <a asp-page="./Login">Върни се към вход</a>.</p>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
