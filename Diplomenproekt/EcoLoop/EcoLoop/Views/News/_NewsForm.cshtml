@model EcoLoop.Models.NewsFormViewModel

<div asp-validation-summary="ModelOnly" class="news-validation"></div>

<div class="news-form-grid">
    <label class="news-form-field">
        <span>Заглавие</span>
        <input asp-for="Title" class="news-input" placeholder="Например: Нови правила за разделно събиране" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </label>

    <label class="news-form-field">
        <span>Категория</span>
        <select asp-for="Category" class="news-input">
            <option value="">Избери категория</option>
            <option>Еко бизнес</option>
            <option>Общество</option>
            <option>Съвети</option>
            <option>Законодателство</option>
            <option>Локални</option>
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </label>

    <label class="news-form-field">
        <span>Автор</span>
        <input asp-for="Author" class="news-input" placeholder="EcoLoop Екип" />
        <span asp-validation-for="Author" class="text-danger"></span>
    </label>

    <label class="news-form-field news-form-field--full">
        <span>Основно изображение</span>
        <input asp-for="UploadedImage" type="file" accept="image/*" class="news-input" id="news-image-input" />

        <div class="image-preview-actions" id="news-image-preview-wrap">
            <img id="news-image-preview"
                 src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "" : Model.ImageUrl)"
                 alt="Преглед на изображение"
                 style="display:@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "none" : "block");" />
            <button type="button" class="clear-filter" id="news-clear-selected" style="display:none;">Премахни избраната снимка</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <label class="remove-current-row">
                <input asp-for="RemoveCurrentImage" type="checkbox" id="news-remove-image" />
                <span>Премахни текущото изображение</span>
            </label>
        }
    </label>

    <label class="news-form-field news-form-field--full">
        <span>Пълен текст</span>
        <textarea asp-for="Content" rows="10" class="news-input" placeholder="Напиши стойностна и полезна новина за общността..."></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </label>
</div>

<script>
    (() => {
        const input = document.getElementById('news-image-input');
        const preview = document.getElementById('news-image-preview');
        const clearSelected = document.getElementById('news-clear-selected');
        const removeBox = document.getElementById('news-remove-image');

        if (!input || !preview) return;

        const showPreview = (src, isVisible) => {
            preview.src = src || '';
            preview.style.display = isVisible ? 'block' : 'none';
        };

        input.addEventListener('change', (e) => {
            const file = e.target.files && e.target.files[0];
            if (!file) {
                clearSelected.style.display = 'none';
                return;
            }

            const reader = new FileReader();
            reader.onload = (ev) => {
                showPreview(ev.target?.result, true);
                clearSelected.style.display = 'inline-flex';
                if (removeBox) removeBox.checked = false;
            };
            reader.readAsDataURL(file);
        });

        clearSelected?.addEventListener('click', () => {
            input.value = '';
            clearSelected.style.display = 'none';
            if (removeBox?.checked) {
                showPreview('', false);
            } else if (!'@Model.ImageUrl') {
                showPreview('', false);
            } else {
                showPreview('@Model.ImageUrl', true);
            }
        });

        removeBox?.addEventListener('change', () => {
            if (removeBox.checked && !input.files?.length) {
                showPreview('', false);
            } else if (!input.files?.length && '@Model.ImageUrl') {
                showPreview('@Model.ImageUrl', true);
            }
        });
    })();
</script>