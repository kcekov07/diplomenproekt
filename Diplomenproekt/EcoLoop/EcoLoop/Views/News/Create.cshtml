@model EcoLoop.Models.NewsFormViewModel
@{
    ViewData["Title"] = "Добави новина";
}

@section Styles {
    <link rel="stylesheet" href="~/css/news.css" asp-append-version="true" />
}

<section class="news-form-wrap">
    <header class="news-form-intro">
        <span class="news-kicker">Редактор</span>
        <h1>Добави новина</h1>
        <p>Създай модерно представена публикация с ясна структура и полезно съдържание.</p>
    </header>
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="news-form-card">
        @Html.AntiForgeryToken()
        <partial name="_NewsForm" model="Model" />

        <div class="news-form-actions">
            <a class="btn btn-ghost" asp-action="All">Отказ</a>
            <button class="btn btn-primary" type="submit">Публикувай</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}