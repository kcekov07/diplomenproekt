@model EcoLoop.Models.AdminDashboardViewModel
@using EcoLoop.Data.Models
@{
    ViewData["Title"] = "Админ панел";
}
@section Styles {
    <link rel="stylesheet" href="~/css/adminpanel.css" asp-append-version="true" />
}
<section class="admin-dashboard">
    <header class="admin-header">
        <div>
            <p class="admin-kicker">Control center</p>
            <h1>Админ панел</h1>
            <p class="admin-subtitle">Управлявай модерирането и следи продажби, прегледи и интерес по магазини от едно място.</p>
        </div>
        <div class="admin-stats">
            <div><strong>@Model.PendingStores.Count</strong><span>Чакащи магазини</span></div>
            <div><strong>@Model.Users.Count</strong><span>Потребители</span></div>
            <div><strong>@Model.AllStores.Count</strong><span>Всички магазини</span></div>
            <div><strong>@Model.RecentComments.Count</strong><span>Последни коментари</span></div>
        </div>
    </header>

    <nav class="admin-section-nav" aria-label="Секции в админ панела">
        <a href="#analytics">📊 Анализ и статистики</a>
        <a href="#stores">🏬 Управление на магазини</a>
        <a href="#users">👥 Потребители</a>
        <a href="#comments">💬 Коментари</a>
    </nav>

    <section class="admin-panel" id="analytics">
        <div class="admin-panel-header">
            <h2>1) Анализ и статистики</h2>
            <span class="admin-pill">Последни 30 дни + общо</span>
        </div>

        <div class="analytics-grid">
            <article class="analytics-card">
                <p class="analytics-label">Потенциални продажби</p>
                <strong id="analytics-potential-revenue">@Model.Analytics.PotentialRevenue.ToString("N2") €</strong>
                <p class="analytics-hint">30 дни: <span id="analytics-potential-revenue-30">@Model.Analytics.PotentialRevenueLast30Days.ToString("N2") €</span></p>
            </article>
            <article class="analytics-card">
                <p class="analytics-label">Прегледи на магазини</p>
                <strong id="analytics-store-views">@Model.Analytics.StoreViews</strong>
                <p class="analytics-hint">30 дни: <span id="analytics-store-views-30">@Model.Analytics.StoreViewsLast30Days</span></p>
            </article>
            <article class="analytics-card">
                <p class="analytics-label">Добавяния в любими</p>
                <strong id="analytics-favorite-actions">@Model.Analytics.FavoriteActions</strong>
                <p class="analytics-hint">30 дни: <span id="analytics-favorite-actions-30">@Model.Analytics.FavoriteActionsLast30Days</span></p>
            </article>
            <article class="analytics-card">
                <p class="analytics-label">Добавяния в количка</p>
                <strong id="analytics-cart-actions">@Model.Analytics.CartActions</strong>
                <p class="analytics-hint">30 дни: <span id="analytics-cart-actions-30">@Model.Analytics.CartActionsLast30Days</span></p>
            </article>
            <article class="analytics-card">
                <p class="analytics-label">Конверсия преглед → любими</p>
                <strong id="analytics-view-to-favorite">@Model.Analytics.ViewToFavoriteRate.ToString("P1")</strong>
                <p class="analytics-hint">Колко от прегледите водят до интерес.</p>
            </article>
            <article class="analytics-card">
                <p class="analytics-label">Конверсия преглед → количка</p>
                <strong id="analytics-view-to-cart">@Model.Analytics.ViewToCartRate.ToString("P1")</strong>
                <p class="analytics-hint">Колко от прегледите водят до намерение за покупка.</p>
            </article>
        </div>

        <div class="admin-subpanel">
            <h3>Най-силни магазини по интерес и потенциални продажби</h3>
            <p class="admin-empty d-none" id="analytics-empty-state">Няма достатъчно данни за анализ.</p>
            <div class="analytics-table-wrap" id="analytics-table-wrap">
                <table class="analytics-table">
                    <thead>
                        <tr>
                            <th>Магазин</th>
                            <th>Прегледи</th>
                            <th>Любими</th>
                            <th>Количка</th>
                            <th>Потенциални продажби</th>
                        </tr>
                    </thead>
                    <tbody id="analytics-top-stores-body">
                        @if (Model.Analytics.TopStorePerformance.Any())
                        {
                            @foreach (var store in Model.Analytics.TopStorePerformance)
                            {
                                <tr>
                                    <td>
                                        <strong>@store.Store.Name</strong>
                                        <div class="analytics-muted">@store.Store.Category</div>
                                    </td>
                                    <td>@store.Views</td>
                                    <td>@store.Favorites</td>
                                    <td>@store.Carts</td>
                                    <td>@store.PotentialRevenue.ToString("N2") €</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="analytics-muted">Все още няма събрани действия за класация по магазини.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="admin-grid" id="stores">
        <article class="admin-panel admin-panel-highlight">
            <div class="admin-panel-header">
                <h2>2) Чакащи за одобрение магазини</h2>
                <span class="admin-pill">@Model.PendingStores.Count чакащи</span>
            </div>
            @if (!Model.PendingStores.Any())
            {
                <p class="admin-empty">Няма чакащи магазини.</p>
            }
            else
            {
                foreach (var store in Model.PendingStores)
                {
                    <div class="admin-row">
                        <div>
                            <strong>@store.Name</strong>
                            <p>@store.Category</p>
                        </div>
                        <div class="admin-actions">
                            <form asp-action="ApproveStore" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@store.Id" /><button class="btn btn-primary">Одобри</button></form>
                            <form asp-action="DeleteStore" method="post" onsubmit="return confirm('Сигурен ли си, че искаш да изтриеш магазина?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@store.Id" /><button class="btn btn-danger">Изтрий</button></form>
                        </div>
                    </div>
                }
            }
        </article>

        <article class="admin-panel">
            <div class="admin-panel-header">
                <h2>3) Всички магазини в платформата</h2>
                <span class="admin-pill">@Model.AllStores.Count магазина</span>
            </div>
            @foreach (var store in Model.AllStores)
            {
                <div class="admin-row">
                    <div>
                        <strong>@store.Name</strong>
                        <p>@store.Category</p>
                        <span class="admin-status @(store.IsApproved ? "admin-status-success" : "admin-status-pending")">@(store.IsApproved ? "Одобрен" : "Чака одобрение")</span>
                    </div>
                    <form asp-action="DeleteStore" method="post" onsubmit="return confirm('Сигурен ли си, че искаш да изтриеш магазина?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@store.Id" />
                        <button class="btn btn-danger">Изтрий</button>
                    </form>
                </div>
            }
        </article>
    </section>

    <section class="admin-grid" id="users">
        <article class="admin-panel">
            <div class="admin-panel-header">
                <h2>4) Всички потребители</h2>
                <span class="admin-pill">@Model.Users.Count потребители</span>
            </div>
            @foreach (var item in Model.Users)
            {
                var profile = item.Profile;
                <div class="admin-row">
                    <div>
                        <strong>@profile.Username</strong>
                        <p>@profile.Role • @profile.Level</p>
                        @if (item.IsLocked)
                        {
                            <span class="admin-status admin-status-danger">Блокиран</span>
                        }
                    </div>
                    @if (User.IsInRole("Admin") && profile.Role != UserRoleType.Admin)
                    {
                        <div class="admin-actions admin-actions-wrap">
                            <form asp-action="PromoteToModerator" method="post">@Html.AntiForgeryToken()<input type="hidden" name="profileId" value="@profile.Id" /><button class="btn btn-secondary">Повиши</button></form>
                            <form asp-action="ToggleUserBlock" method="post">@Html.AntiForgeryToken()<input type="hidden" name="profileId" value="@profile.Id" /><button class="btn btn-warning">@(item.IsLocked ? "Отблокирай" : "Блокирай")</button></form>
                            <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Сигурен ли си, че искаш да изтриеш потребителя?');">@Html.AntiForgeryToken()<input type="hidden" name="profileId" value="@profile.Id" /><button class="btn btn-danger">Изтрий профил</button></form>
                        </div>
                    }
                </div>
            }
        </article>
    </section>

    <section class="admin-grid" id="comments">
        <article class="admin-panel">
            <div class="admin-panel-header">
                <h2>5) Модериране на коментари</h2>
                <span class="admin-pill">@Model.RecentComments.Count коментара</span>
            </div>
            @if (!Model.RecentComments.Any())
            {
                <p class="admin-empty">Няма коментари за модериране.</p>
            }
            else
            {
                foreach (var item in Model.RecentComments)
                {
                    <div class="admin-row">
                        <div>
                            <strong>@item.TargetTitle</strong>
                            <p>@item.Comment.Text</p>
                        </div>
                        <form asp-action="DeleteComment" method="post" onsubmit="return confirm('Изтриване на коментара?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Comment.Id" />
                            <button class="btn btn-danger">Изтрий коментар</button>
                        </form>
                    </div>
                }
            }
        </article>
    </section>
</section>

@section Scripts {
    <script>
        (() => {
            const endpoint = '@Url.Action("AnalyticsSnapshot", "Admin")';
            const pollIntervalMs = 3000;
            const moneyFormatter = new Intl.NumberFormat('bg-BG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const intFormatter = new Intl.NumberFormat('bg-BG');
            const percentFormatter = new Intl.NumberFormat('bg-BG', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 });

            const elements = {
                potentialRevenue: document.getElementById('analytics-potential-revenue'),
                potentialRevenue30: document.getElementById('analytics-potential-revenue-30'),
                storeViews: document.getElementById('analytics-store-views'),
                storeViews30: document.getElementById('analytics-store-views-30'),
                favoriteActions: document.getElementById('analytics-favorite-actions'),
                favoriteActions30: document.getElementById('analytics-favorite-actions-30'),
                cartActions: document.getElementById('analytics-cart-actions'),
                cartActions30: document.getElementById('analytics-cart-actions-30'),
                viewToFavorite: document.getElementById('analytics-view-to-favorite'),
                viewToCart: document.getElementById('analytics-view-to-cart'),
                topStoresBody: document.getElementById('analytics-top-stores-body'),
                emptyState: document.getElementById('analytics-empty-state'),
                tableWrap: document.getElementById('analytics-table-wrap')
            };

            if (Object.values(elements).some(x => !x)) {
                return;
            }

            let isLoading = false;

            const setContent = (el, text) => {
                if (el.textContent !== text) {
                    el.textContent = text;
                }
            };

            const buildStoreRow = (store) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        <strong>${store.name}</strong>
                        <div class="analytics-muted">${store.category}</div>
                    </td>
                    <td>${intFormatter.format(store.views)}</td>
                    <td>${intFormatter.format(store.favorites)}</td>
                    <td>${intFormatter.format(store.carts)}</td>
                    <td>${moneyFormatter.format(store.potentialRevenue)} €</td>
                `;
                return tr;
            };

            const updateTopStores = (stores) => {
                elements.topStoresBody.innerHTML = '';

                if (!stores || stores.length === 0) {
                    elements.emptyState.classList.remove('d-none');
                    elements.tableWrap.classList.add('d-none');
                    return;
                }

                elements.emptyState.classList.add('d-none');
                elements.tableWrap.classList.remove('d-none');
                stores.forEach(store => {
                    elements.topStoresBody.appendChild(buildStoreRow(store));
                });
            };

            const updateUI = (data) => {
                setContent(elements.potentialRevenue, `${moneyFormatter.format(data.potentialRevenue)} €`);
                setContent(elements.potentialRevenue30, `${moneyFormatter.format(data.potentialRevenueLast30Days)} €`);
                setContent(elements.storeViews, intFormatter.format(data.storeViews));
                setContent(elements.storeViews30, intFormatter.format(data.storeViewsLast30Days));
                setContent(elements.favoriteActions, intFormatter.format(data.favoriteActions));
                setContent(elements.favoriteActions30, intFormatter.format(data.favoriteActionsLast30Days));
                setContent(elements.cartActions, intFormatter.format(data.cartActions));
                setContent(elements.cartActions30, intFormatter.format(data.cartActionsLast30Days));
                setContent(elements.viewToFavorite, percentFormatter.format(data.viewToFavoriteRate));
                setContent(elements.viewToCart, percentFormatter.format(data.viewToCartRate));
                updateTopStores(data.topStorePerformance);
            };

            const loadAnalytics = async () => {
                if (isLoading) {
                    return;
                }

                isLoading = true;
                try {
                    const response = await fetch(endpoint, { method: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' }, cache: 'no-store' });
                    if (!response.ok) {
                        return;
                    }

                    const data = await response.json();
                    updateUI(data);
                } catch {
                    // keep silent to avoid noisy console errors in admin panel
                } finally {
                    isLoading = false;
                }
            };

            loadAnalytics();
            setInterval(loadAnalytics, pollIntervalMs);
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') {
                    loadAnalytics();
                }
            });
            window.addEventListener('focus', loadAnalytics);
        })();
    </script>
}
