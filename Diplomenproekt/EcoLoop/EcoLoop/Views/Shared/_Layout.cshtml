@using EcoLoop.Data.Models
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>EcoFind - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/footer.css" />
    <script src="~/js/site.js" defer></script>
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="site-header navbar-eco">
        <div class="container navbar-inner">
            <a class="brand" href="/">
                <img src="~/images/logo-eco.svg" alt="EcoLoop" class="brand-logo" />
                <span class="brand-title">EcoLoop</span>
            </a>

            <button id="navToggle" class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">☰</button>

            <nav class="main-nav" aria-label="Main navigation">
                <a class="nav-link" href="/"><span class="nav-icon">🏠</span><span class="nav-text">Начало</span></a>
                <a class="nav-link" href="/map"><span class="nav-icon">🗺️</span><span class="nav-text">Карта</span></a>
                <a class="nav-link" href="/Events/All"><span class="nav-icon">📅</span><span class="nav-text">Събития</span></a>
                <a class="nav-link" href="/News/All"><span class="nav-icon">📰</span><span class="nav-text">Новини</span></a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" href="/Store/Cart"><span class="nav-icon">🛒</span><span class="nav-text">Количка</span></a>
                }
                @if (User.IsInRole(UserRoleType.Producer) || User.IsInRole(UserRoleType.Moderator) || User.IsInRole(UserRoleType.Admin))
                {
                    <a class="nav-link" href="/Store/Add"><span class="nav-icon">➕</span><span class="nav-text">Добави обект</span></a>
                }
                @if (User.IsInRole(UserRoleType.Admin) || User.IsInRole(UserRoleType.Moderator))
                {
                    <a class="nav-link" href="/Admin/Index"><span class="nav-icon">🔧</span><span class="nav-text">Админ</span></a>
                }
            </nav>

            <div class="nav-actions">
                <form class="nav-search" method="get" action="/Store/All" role="search" aria-label="Site search">
                    <button type="submit" class="search-icon" aria-hidden="true">🔍</button>
                    <input name="q" type="search" class="nav-search-input" placeholder="Търси обекти, събития, новини…" />
                </form>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <details class="profile-dropdown">
                        <summary class="btn btn-primary">Профил ▾</summary>
                        <div class="dropdown-menu">
                            <a href="/Profile/MyProfile">Моят профил</a>
                            <a href="/Profile/Edit">Редакция на профила</a>
                            @if (!User.IsInRole(UserRoleType.Admin))
                            {
                                <a href="/Profile/Statistics">Статистики</a>
                                <a href="/Profile/LevelGuide">Нива и точки</a>
                            }
                            @if (User.IsInRole(UserRoleType.Producer) || User.IsInRole(UserRoleType.Moderator) || User.IsInRole(UserRoleType.Admin))
                            {
                                <a href="/Profile/MyStores">Моите магазини</a>
                            }
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                                <button type="submit" class="btn btn-link">Изход</button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <div class="auth-buttons">
                        <a class="btn btn-link btn-ghost" href="/Identity/Account/Login">Вход</a>
                        <a class="btn btn-primary" href="/Identity/Account/Register">Регистрация</a>
                    </div>
                }
            </div>
        </div>

        <div id="mobileNav" class="mobile-nav" aria-hidden="true">
            <nav aria-label="Mobile navigation">
                <a class="nav-link" href="/"><span class="nav-icon">🏠</span><span class="nav-text">Начало</span></a>
                <a class="nav-link" href="/map"><span class="nav-icon">🗺️</span><span class="nav-text">Карта</span></a>
                <a class="nav-link" href="/Events/All"><span class="nav-icon">📅</span><span class="nav-text">Събития</span></a>
                <a class="nav-link" href="/News/All"><span class="nav-icon">📰</span><span class="nav-text">Новини</span></a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" href="/Store/Cart"><span class="nav-icon">🛒</span><span class="nav-text">Количка</span></a>
                }
                @if (User.IsInRole(UserRoleType.Producer) || User.IsInRole(UserRoleType.Moderator) || User.IsInRole(UserRoleType.Admin))
                {
                    <a class="nav-link" href="/Store/Add"><span class="nav-icon">➕</span><span class="nav-text">Добави обект</span></a>
                }
                @if (User.IsInRole(UserRoleType.Admin) || User.IsInRole(UserRoleType.Moderator))
                {
                    <a class="nav-link" href="/Admin/Index"><span class="nav-icon">🔧</span><span class="nav-text">Админ</span></a>
                }

                <form class="mobile-search" method="get" action="/Store/All" role="search" aria-label="Mobile site search">
                    <button type="submit" class="search-icon" aria-hidden="true">🔍</button>
                    <input name="q" type="search" class="nav-search-input" placeholder="Търси..." />
                </form>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" href="/Profile/MyProfile">Моят профил</a>
                    <a class="nav-link" href="/Profile/Edit">Редакция на профила</a>
                    @if (!User.IsInRole(UserRoleType.Admin))
                    {
                        <a class="nav-link" href="/Profile/Statistics">Статистики</a>
                        <a class="nav-link" href="/Profile/LevelGuide">Нива и точки</a>
                    }
                    @if (User.IsInRole(UserRoleType.Producer) || User.IsInRole(UserRoleType.Moderator) || User.IsInRole(UserRoleType.Admin))
                    {
                        <a class="nav-link" href="/Profile/MyStores">Моите магазини</a>
                    }
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                        <button type="submit" class="btn btn-link mobile-logout">Изход</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-link btn-ghost mobile-auth-btn" href="/Identity/Account/Login">Вход</a>
                    <a class="btn btn-primary mobile-auth-btn" href="/Identity/Account/Register">Регистрация</a>
                }
            </nav>
        </div>
    </header>

    <main role="main" class="container main-content">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    @RenderSection("Scripts", required: false)
</body>
</html>